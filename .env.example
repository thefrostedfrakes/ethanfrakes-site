# Copy to `.env` and fill in. Used by docker-compose.

# Cloudflare Tunnel token for the `cloudflared` service in docker-compose.yml.
# Publishes the site at ethanfrakes.com (and www, which redirects to the apex)
# with automatic HTTPS and no open inbound ports. Create a tunnel in the
# Cloudflare dashboard (Zero Trust → Networks → Tunnels), add the public
# hostnames ethanfrakes.com -> http://web:8080 and
# www.ethanfrakes.com -> http://web:8080, and paste the token here.
# Keep the REAL token in .env only — never commit it.
CLOUDFLARE_TUNNEL_TOKEN=
